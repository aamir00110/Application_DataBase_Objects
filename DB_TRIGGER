----PREVENTIVE DB TRIGGER---
CREATE OR REPLACE EDITIONABLE TRIGGER MS_PM_PLAN_H_PLAN_NO_TRIG
BEFORE INSERT ON MS_PM_PLAN_H
FOR EACH ROW
DECLARE
    V_PLAN_NO NUMBER;
    V_PLAN_ID NUMBER;
BEGIN
    -- Generate PLAN Number
    IF :NEW.PLAN_NO IS NULL THEN
        SELECT NVL(MAX(TO_NUMBER(SUBSTR(PLAN_NO, 5))), 0) + 1
          INTO V_PLAN_NO
          FROM MS_PM_PLAN_H
         WHERE REGEXP_LIKE(PLAN_NO, '^PLAN[0-9]+$');

        :NEW.PLAN_NO := 'PLAN' || LPAD(V_PLAN_NO, 4, '0');
    END IF;

    -- Generate PLAN ID
    IF :NEW.PLAN_ID IS NULL THEN
        SELECT NVL(MAX(PLAN_ID), 0) + 1
          INTO V_PLAN_ID
          FROM MS_PM_PLAN_H;

        :NEW.PLAN_ID := V_PLAN_ID;
    END IF;
END;
